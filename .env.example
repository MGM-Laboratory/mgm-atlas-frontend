PORT=3001
HOST_PORT=3001

# ─── Public ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://atlas.labmgm.org
NEXT_PUBLIC_API_URL=https://atlas.labmgm.org/api/v1
NEXT_PUBLIC_KEYCLOAK_ACCOUNT_URL=https://iam.labmgm.org/realms/mgm/account
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://iam.labmgm.org/realms/mgm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=atlas-web

# Optional. The chat WebSocket origin. When unset the runtime derives it
# from NEXT_PUBLIC_API_URL minus the /api/vN suffix, so existing
# deployments don't need to set anything. Override only if sockets
# terminate on a different host (e.g. a dedicated WS subdomain).
NEXT_PUBLIC_SOCKET_URL=

# ─── Auth.js (NextAuth v5) ─────────────────────────────────────────────────
AUTH_SECRET=change-this
AUTH_TRUST_HOST=true
AUTH_URL=https://atlas.labmgm.org

# ─── Keycloak (server-side OIDC) ───────────────────────────────────────────
NEXT_PUBLIC_KEYCLOAK_ACCOUNT_URL=https://iam.labmgm.org/realms/mgm/account
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://iam.labmgm.org/realms/mgm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=mgm-atlas

AUTH_KEYCLOAK_ISSUER=https://iam.labmgm.org/realms/mgm
KEYCLOAK_CLIENT_SECRET=change-this

# ─── PMO (project management office) ────────────────────────────────────────
# Global kill switch. Must match the backend's PMO_ENABLED at deploy time:
# - "true"  → PMO routes mount, sidebar entry shows for insiders.
# - "false" → all PMO UI is hidden, routes 404 client-side. Default until
#             Phase 1 ships.
NEXT_PUBLIC_PMO_ENABLED=false

# Yjs sync URL for collaborative notes + whiteboards (Phase 8+). Empty
# means collab is disabled and the editor falls back to single-edit mode.
NEXT_PUBLIC_YJS_WS_URL=

# ─── Voice chat (Phase 0) ───────────────────────────────────────────────────
# Global kill switch. Must match the backend's VOICE_ENABLED at deploy time:
# - "true"  → voice routes mount, sidebar voice rows render for insiders,
#             persistent voice panel mounts.
# - "false" → all voice UI is hidden, routes 404 client-side. Default until
#             Phase 1 ships.
NEXT_PUBLIC_VOICE_ENABLED=false

# Public LiveKit signaling URL the browser connects to, e.g.
# wss://<your-domain>/livekit (served by the reverse proxy in front of
# the LiveKit container). Empty means voice is unavailable on this
# deploy — UI degrades to a "voice temporarily unavailable" banner.
NEXT_PUBLIC_LIVEKIT_URL=
