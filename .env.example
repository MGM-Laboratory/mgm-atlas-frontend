PORT=3001
HOST_PORT=3001

# ─── Public ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://atlas-staging.labmgm.org
NEXT_PUBLIC_API_URL=https://atlas-staging.labmgm.org/api/v1
NEXT_PUBLIC_KEYCLOAK_ACCOUNT_URL=https://iam.labmgm.org/realms/mgm/account
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://iam.labmgm.org/realms/mgm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=atlas-web

# ─── Auth.js (NextAuth v5) ─────────────────────────────────────────────────
AUTH_SECRET=change-this
AUTH_TRUST_HOST=true
AUTH_URL=https://atlas-staging.labmgm.org

# ─── Keycloak (server-side OIDC) ───────────────────────────────────────────
AUTH_KEYCLOAK_ISSUER=https://iam.labmgm.org/realms/mgm
AUTH_KEYCLOAK_CLIENT_ID=mgm-atlas-staging
AUTH_KEYCLOAK_SECRET=change-this

NEXT_PUBLIC_KEYCLOAK_ACCOUNT_URL=https://iam.labmgm.org/realms/mgm/account
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://iam.labmgm.org/realms/mgm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=mgm-atlas-staging

AUTH_KEYCLOAK_SECRET=change-this
KEYCLOAK_CLIENT_SECRET=change-this
