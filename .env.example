# ─── Public ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://atlas.labmgm.org
NEXT_PUBLIC_API_URL=https://atlas.labmgm.org/api/v1
NEXT_PUBLIC_KEYCLOAK_ACCOUNT_URL=https://iam.labmgm.org/realms/mgm/account

# ─── Auth.js (NextAuth v5) ─────────────────────────────────────────────────
AUTH_SECRET=replace_with_long_random_hex
AUTH_TRUST_HOST=true
AUTH_URL=https://atlas.labmgm.org

# ─── Keycloak (server-side OIDC) ───────────────────────────────────────────
AUTH_KEYCLOAK_ISSUER=https://iam.labmgm.org/realms/mgm
AUTH_KEYCLOAK_ID=atlas-web
AUTH_KEYCLOAK_SECRET=replace_with_keycloak_client_secret
